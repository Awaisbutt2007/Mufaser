---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import FaqList from '../../../components/FaqList.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import {
  categories, categoryBySlug, categoryUrl, coverProduct, groups, heroSources, type Category,
} from '../../../data/catalog';
import { company } from '../../../data/company';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

interface Props { category: Category }
const { category: c } = Astro.props;
const group = groups.find((g) => g.id === c.group)!;
const hero = c.hero ? heroSources(c.hero) : null;
const related = (c.related ?? categories.filter((x) => x.group === c.group && x.slug !== c.slug).map((x) => x.slug))
  .map((s) => categoryBySlug[s])
  .filter(Boolean)
  .slice(0, 8);
const groupsInCat = [...new Set(c.products.map((p) => p.group))];
const hasPending = c.products.some((p) => !p.image);
const collage = c.products.filter((p) => p.image).slice(0, 3);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Collections', item: new URL('/collections/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: c.name, item: new URL(categoryUrl(c), Astro.site).href },
  ],
};
const title = c.kind === 'view' ? `Custom ${c.name} Manufacturer` : `Custom ${c.name} Uniforms & Apparel`;
const description = `${c.intro} Made to order by ${company.name} in Sialkot, Pakistan. Request a quote.`.slice(0, 300);
---
<Base
  title={title}
  description={description}
  preload={hero ? { href: hero.src, srcset: hero.srcset, sizes: '100vw' } : undefined}
  jsonLd={[breadcrumbLd]}
>
  <section class={`page-hero${hero ? '' : ' page-hero--plain'}`}>
    {hero && (
      <img class="page-hero-bg" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt="" fetchpriority="high" style={`object-position:${c.heroPosition}`} />
    )}
    <div class="container" style={hero ? undefined : 'display:grid;gap:2rem;align-items:center;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))'}>
      <div>
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collections', href: '/collections/' }, { label: c.name }]} />
        <span class="eyebrow">{group.name}</span>
        <h1 class="display" style="margin-top:1rem">{c.name}</h1>
        <p class="lead">{c.intro}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#quote">Request a Quote <Icon name="arrow" /></a>
          {c.group === 'team' && <a class="btn btn--ghost" href={`/design-your-kit/?sport=${c.slug}`}>Design your kit</a>}
        </div>
      </div>
      {!hero && collage.length > 0 && (
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem" aria-hidden="true">
          {collage.map((p) => (
            <img src={`${p.image}-480.webp`} srcset={`${p.image}-240.webp 240w, ${p.image}-480.webp 480w`} sizes="(min-width: 960px) 14vw, 30vw" width="480" height="480" alt="" style="filter:drop-shadow(0 20px 26px rgba(0,0,0,.55))" />
          ))}
        </div>
      )}
    </div>
    {c.heroCredit && (
      <p class="photo-credit">Editorial photo: <a href={c.heroCredit.photo} rel="noopener" target="_blank">{c.heroCredit.author}</a> / Unsplash. Not a Mufasar product.</p>
    )}
  </section>

  {c.kind === 'hub' ? (
    <section class="section section--light" aria-labelledby="disciplines-title">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Disciplines</span>
          <h2 id="disciplines-title" class="display h2">Choose your discipline</h2>
        </div>
        <div class="collection-list">
          {related.map((r) => {
            const cover = coverProduct(r);
            return (
              <a class="collection-link" href={categoryUrl(r)}>
                <span class="m">
                  {cover?.image
                    ? <img src={`${cover.image}-240.webp`} width="240" height="240" alt="" loading="lazy" decoding="async" />
                    : <img class="photo" src={`/assets/hero/${r.hero}-960.webp`} width="960" height="407" alt="" loading="lazy" decoding="async" />}
                </span>
                <span><strong>{r.name}</strong><small>{r.summary}</small></span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ) : (
    <section class="section section--light" aria-labelledby="products-title" data-collection>
      <div class="container">
        <div class="collection-toolbar">
          <div>
            <h2 id="products-title" class="display" style="font-size:var(--step-3)">{c.name} products</h2>
            <p class="result-count" aria-live="polite" data-count>{c.products.length} styles</p>
          </div>
          {groupsInCat.length > 1 && (
            <div class="filter-tabs" role="group" aria-label="Filter products">
              <button type="button" aria-pressed="true" data-filter="all">All</button>
              {groupsInCat.map((g) => <button type="button" aria-pressed="false" data-filter={g}>{g}</button>)}
            </div>
          )}
        </div>
        <div class="product-grid">
          {c.products.map((p, i) => <ProductCard product={p} showCategory={c.kind === 'view'} eager={i < 2} />)}
        </div>
        {hasPending && (
          <p class="notice" style="margin-top:1.5rem">Photography for these styles is in production. Each style is made to order. Send your requirements and we will share samples and references with your quotation.</p>
        )}
      </div>
    </section>
  )}

  <section class="section section--paper" aria-labelledby="custom-title">
    <div class="container cat-intro">
      <div class="stack" style="--stack:1.25rem">
        <span class="eyebrow">Customisation</span>
        <h2 id="custom-title" class="display h2" style="font-size:var(--step-4)">Made to your specification</h2>
        <ul class="tick-list">
          {c.options.map((o) => <li><Icon name="check" />{o}</li>)}
          <li><Icon name="check" />Sublimation, embroidery, print or transfers, recommended per garment</li>
          <li><Icon name="check" />Physical sample approved before bulk production</li>
        </ul>
        <a class="link-arrow" href="/custom-manufacturing/">How custom manufacturing works <Icon name="arrow" /></a>
      </div>
      <div>
        <h3 class="display" style="font-size:var(--step-2);margin-bottom:1rem">Questions buyers ask</h3>
        <FaqList items={c.faqs} />
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--navy-850)" aria-label="Request a quote">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:1.25rem">
        <span class="eyebrow">Quotation</span>
        <h2 class="display h2">Get a price for your {c.name.toLowerCase()} order</h2>
        <p class="lead">Share the garments, quantity and branding. Pricing depends on fabric, decoration and quantity, so every quotation is prepared for your specification.</p>
        {related.length > 0 && c.kind !== 'hub' && (
          <div style="margin-top:2rem">
            <p class="eyebrow" style="margin-bottom:.8rem">Related collections</p>
            <ul class="chips">
              {related.map((r) => <li><a href={categoryUrl(r)} style="text-decoration:none">{r.name}</a></li>)}
            </ul>
          </div>
        )}
      </div>
      <QuoteForm id="quote" product={`${c.name} (collection)`} heading={`${c.name} quote`} />
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-collection]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-product-card]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      cards.forEach((card) => {
        const ok = f === 'all' || card.dataset.group === f;
        card.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = `${shown} style${shown === 1 ? '' : 's'}`;
    }));
  }
</script>
