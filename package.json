{
  "name": "mufasar-enterprises-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mufasar Enterprises — custom sportswear manufacturing website (static Astro build).",
  "scripts": {
    "assets": "python -I scripts/build_assets.py",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "node scripts/serve.mjs",
    "check": "astro check",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "audit:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
