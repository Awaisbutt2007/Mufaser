---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import GarmentArt from '../../../../components/GarmentArt.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import {
  allProducts, categoryBySlug, categoryUrl, craftSources, heroSources, productSources, productUrl, type Product,
} from '../../../../data/catalog';
import { company, facts, moqLabel } from '../../../../data/company';

export function getStaticPaths() {
  return allProducts.map((p) => ({ params: { slug: p.categorySlug, product: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product: p } = Astro.props;
const category = categoryBySlug[p.categorySlug];
const img = p.image ? productSources(p.image) : null;

const technique =
  p.garment === 'gi' || p.garment === 'belt' ? 'embroidery'
  : p.categorySlug === 'streetwear' || p.garment === 'hoodie' ? 'screen-print'
  : p.categorySlug === 'american-football' || p.categorySlug === 'ice-hockey' ? 'tackle-twill'
  : 'sublimation';
const techniqueLabel: Record<string, string> = {
  embroidery: 'Embroidery detail', 'screen-print': 'Screen print detail', 'tackle-twill': 'Tackle twill detail', sublimation: 'Sublimation detail',
};

type Shot = { key: string; src: string; srcset?: string; w: number; h: number; alt: string; caption: string; photo: boolean };
const shots: Shot[] = [];
if (img) shots.push({ key: 'product', src: img.large, srcset: img.srcset, w: img.width, h: img.height, alt: `${p.name}, concept visual in example colours`, caption: 'Concept visual in example colours. Your order is made in your colours and branding.', photo: false });
if (category.hero) {
  const h = heroSources(category.hero);
  shots.push({ key: 'context', src: `/assets/hero/${category.hero}-1600.webp`, srcset: h.srcset, w: 1600, h: 679, alt: `${category.name} teamwear in use`, caption: category.heroCredit ? `Editorial photo: ${category.heroCredit.author} / Unsplash. Not a Mufasar product.` : 'Atmosphere visual. Garments shown are illustrative.', photo: true });
}
const craft = craftSources(technique);
shots.push({ key: 'detail', src: `/assets/craft/${technique}-1200.webp`, srcset: craft.srcset, w: craft.width, h: craft.height, alt: `${techniqueLabel[technique]} example`, caption: `${techniqueLabel[technique]}: illustrative example of the technique.`, photo: true });

const specs: [string, string][] = [
  ['Category', category.name],
  ['Style group', p.group],
  ...p.specs.filter(([k]) => k !== 'Minimum order'),
  ['Minimum order', moqLabel],
  ['Fabric', 'Agreed with you and confirmed on the sample'],
  ['Sample lead time', `${facts.sampleLeadTime.value} (typical)`],
  ['Bulk lead time', `${facts.bulkLeadTime.value} after sample approval (typical)`],
  ['Price', 'Quoted to your specification and quantity'],
];
const related = allProducts.filter((x) => x.categorySlug === p.categorySlug && x.slug !== p.slug).slice(0, 4);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Collections', item: new URL('/collections/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: category.name, item: new URL(categoryUrl(category), Astro.site).href },
    { '@type': 'ListItem', position: 4, name: p.name, item: new URL(productUrl(p), Astro.site).href },
  ],
};
---
<Base
  title={`Custom ${p.name} | ${category.name}`}
  description={`${p.description} Manufactured by ${company.name}, Sialkot, Pakistan.`.slice(0, 300)}
  image={img ? img.large : undefined}
  preload={img ? { href: img.large } : undefined}
  jsonLd={[breadcrumbLd]}
>
  <div style="background:var(--navy-900);height:var(--header-h)"></div>
  <section class="section section--paper" style="padding-top:clamp(1.5rem,1rem + 2vw,3rem)">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collections', href: '/collections/' }, { label: category.name, href: categoryUrl(category) }, { label: p.name }]} />
      <div class="pdp">
        <div class="gallery" data-gallery>
          <div class="gallery-main">
            {shots.length ? shots.map((s, i) => (
              <figure data-shot={s.key} hidden={i !== 0}>
                <img
                  class={s.photo ? 'photo' : undefined}
                  src={i === 0 ? s.src : undefined}
                  data-src={s.src}
                  srcset={i === 0 ? s.srcset : undefined}
                  data-srcset={s.srcset}
                  sizes="(min-width: 980px) 55vw, 100vw"
                  width={s.w}
                  height={s.h}
                  alt={s.alt}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                <figcaption>{s.caption}</figcaption>
              </figure>
            )) : null}
            {!img && (
              <div style="position:absolute;inset:0;display:grid;place-items:center" data-placeholder>
                <GarmentArt garment={p.garment} class="placeholder-art" />
                <span class="placeholder-note">Photography coming soon</span>
              </div>
            )}
          </div>
          {shots.length > 1 && (
            <ul class="gallery-thumbs" aria-label="Product images">
              {shots.map((s, i) => (
                <li>
                  <button type="button" aria-current={i === 0 ? "true" : "false"} aria-label={`Show image ${i + 1} of ${shots.length}: ${s.alt}`} data-thumb={s.key}>
                    <img class={s.photo ? undefined : 'cut'} src={s.key === 'product' ? `${p.image}-240.webp` : s.key === 'context' ? `/assets/hero/${category.hero}-960.webp` : craft.src} width="84" height="84" alt="" loading="lazy" decoding="async" />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="pdp-info">
          <div class="stack" style="--stack:.8rem">
            <span class="eyebrow">{category.name} · {p.group}</span>
            <h1 class="display">{p.name}</h1>
            <p class="lead">{p.description}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--dark" href="#quote">Request a Quote <Icon name="arrow" /></a>
            {category.group === 'team' && <a class="btn btn--outline-dark" href={`/design-your-kit/?sport=${category.slug}&garment=${p.slug}`}>Design this kit</a>}
          </div>
          <div>
            <h2>Specification</h2>
            <table class="spec-table">
              <tbody>
                {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
              </tbody>
            </table>
          </div>
          <div>
            <h2>Customisation options</h2>
            <ul class="tick-list" style="margin-top:.8rem">
              {category.options.map((o) => <li><Icon name="check" />{o}</li>)}
              <li><Icon name="check" />Decoration method recommended for your design with the quotation</li>
              <li><Icon name="check" />Woven labels, hangtags and packaging for private-label orders</li>
            </ul>
          </div>
          <div>
            <h2>Sizing</h2>
            <p class="muted" style="margin-top:.5rem">{facts.sizes.value}. A size chart is supplied with your quotation, and {facts.sizingKit.value.charAt(0).toLowerCase()}{facts.sizingKit.value.slice(1)}.</p>
          </div>
          <p class="notice">Care labels are prepared for your destination market. Fabric composition, weight and care instructions are confirmed on the approved sample.</p>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--light section--tight" aria-labelledby="related-title">
      <div class="container">
        <div class="collection-toolbar">
          <h2 id="related-title" class="display" style="font-size:var(--step-3)">More {category.name}</h2>
          <a class="link-arrow" href={categoryUrl(category)}>View collection <Icon name="arrow" /></a>
        </div>
        <div class="product-grid">{related.map((r) => <ProductCard product={r} showCategory={false} />)}</div>
      </div>
    </section>
  )}

  <section class="section" style="background:var(--navy-850)" aria-label="Request a quote">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:1.25rem">
        <span class="eyebrow">Quotation</span>
        <h2 class="display h2">Quote for {p.name.toLowerCase()}</h2>
        <p class="lead">{company.name} prepares pricing for your fabric, decoration and quantity. {facts.responseTime.value}.</p>
      </div>
      <QuoteForm id="quote" product={p.name} heading="Request a quotation" />
    </div>
  </section>
</Base>

<script>
  const g = document.querySelector<HTMLElement>('[data-gallery]');
  if (g) {
    const figs = [...g.querySelectorAll<HTMLElement>('[data-shot]')];
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    thumbs.forEach((t) => t.addEventListener('click', () => {
      figs.forEach((f) => {
        const on = f.dataset.shot === t.dataset.thumb;
        f.hidden = !on;
        const img = f.querySelector('img')!;
        if (on && !img.getAttribute('src')) {
          if (img.dataset.srcset) img.srcset = img.dataset.srcset;
          img.src = img.dataset.src!;
        }
      });
      thumbs.forEach((x) => x.setAttribute('aria-current', String(x === t)));
    }));
  }
</script>
