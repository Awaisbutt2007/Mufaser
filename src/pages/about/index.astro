---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FinalCta from '../../components/FinalCta.astro';
import { company, facts } from '../../data/company';
import { categories, groups, categoriesIn, craftSources } from '../../data/catalog';

const production = [
  { img: 'process-cutting', title: 'Pattern & cutting', alt: 'Fabric being cut to garment patterns', body: 'Patterns are graded to your size range and fabric is cut panel by panel to the approved specification.' },
  { img: 'process-printing', title: 'Printing & decoration', alt: 'Sublimation printing of a team design', body: 'Your colours, crests, sponsors, names and numbers are applied by sublimation, screen print, embroidery or transfer.' },
  { img: 'process-sewing', title: 'Stitching & finishing', alt: 'Garment panels being stitched on a sewing machine', body: 'Panels are stitched, trims and labels are attached, and each garment is finished and pressed.' },
  { img: 'process-quality', title: 'Quality check & packing', alt: 'A finished garment being inspected', body: 'Every piece is inspected against your approved sample, then packed with your labels and packaging for dispatch.' },
];

const confirmedExtras = [facts.chamberMembership].filter((f) => f.confirmed).map((f) => f.value);
const markets = company.markets.join(', ').replace(/, ([^,]*)$/, ' and $1');
---
<Base
  title="About Us"
  description={`${company.name} is a sportswear and textile manufacturer and exporter in ${company.city}, ${company.country}, producing custom teamwear, combat sportswear, activewear and private-label apparel.`}
>
  <section class="page-hero">
    <img class="page-hero-bg" src="/assets/hero/cricket-1600.webp" srcset="/assets/hero/cricket-960.webp 960w, /assets/hero/cricket-1600.webp 1600w, /assets/hero/cricket-2560.webp 2560w" sizes="100vw" width="1600" height="679" alt="" fetchpriority="high" style="object-position:60% 50%" />
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About us' }]} />
      <span class="eyebrow">About {company.name}</span>
      <h1 class="display" style="margin-top:1rem">From fabric to <span class="gold-text">finished kit</span></h1>
      <p class="lead">A {company.legalDescriptor.toLowerCase()} based in {company.city}, {company.country}.</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container split" style="align-items:start">
      <div class="stack" style="--stack:1.25rem">
        <span class="eyebrow">Who we are</span>
        <h2 class="display h2">One team from first message to delivery</h2>
      </div>
      <div class="stack prose" style="--stack:1.1rem">
        <p>{company.name} manufactures and exports sports and textile products, producing to buyer specification for brands, teams, distributors and private-label programmes. {facts.inHouse.value}, and every order is confirmed against an approved sample before it ships.</p>
        <p>You work with one team from your first message to delivery: your mockup is prepared, a sample is made for you to check, then your full order is produced to that sample.</p>
        <p>We are based in {company.city}, Pakistan, a long-established centre of sportswear and sporting-goods manufacturing, and work with buyers in {markets}.</p>
        {confirmedExtras.map((x) => <p>{x}.</p>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="range-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we make</span>
        <h2 id="range-title" class="display h2">{categories.length} collections, three families</h2>
      </div>
      <div class="why-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr))">
        {groups.map((g) => (
          <article class="why-item" style="background:linear-gradient(170deg,var(--navy-800),var(--navy-900));border-color:var(--line-dark)">
            <h3 style="color:var(--text-on-dark)">{g.name}</h3>
            <p style="color:var(--text-on-dark-muted)">{categoriesIn(g.id).map((c) => c.name).join(', ')}.</p>
            <a class="link-arrow" href={`/collections/#${g.id}`}>Explore <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="production-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <span class="eyebrow">Our product process</span>
          <h2 id="production-title" class="display h2">How your kit is made</h2>
        </div>
        <p class="lead">{facts.inHouse.value}. Every stage is checked against your approved sample.</p>
      </div>
      <ol class="production">
        {production.map((s, i) => {
          const img = craftSources(s.img);
          return (
            <li class="production-step">
              <figure>
                <img src={img.src} srcset={img.srcset} sizes="(min-width: 1000px) 25vw, (min-width: 620px) 50vw, 100vw" width={img.width} height={img.height} alt={s.alt} loading="lazy" decoding="async" />
                <span class="production-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </figure>
              <div class="production-body">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          );
        })}
      </ol>
      <p class="illustrative">Illustrative images of each production stage, not photographs of the {company.name} factory.</p>
    </div>
  </section>

  <section class="section" style="background:var(--navy-850)" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2 id="process-title" class="display h2">Our order process</h2>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <FinalCta image="soccer" />
</Base>
