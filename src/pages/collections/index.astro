---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import FinalCta from '../../components/FinalCta.astro';
import { allProducts, categories, categoriesIn, categoryUrl, coverProduct, groups } from '../../data/catalog';
---
<Base
  title="Sportswear Collections: Teamwear, Combat, Activewear & Streetwear"
  description="Browse custom sportswear collections from Mufasar Enterprises: team kits for ten sports, combat sportswear, activewear and streetwear, all made to order in your colours."
>
  <section class="page-hero">
    <img class="page-hero-bg" src="/assets/hero/rugby-1600.webp" srcset="/assets/hero/rugby-960.webp 960w, /assets/hero/rugby-1600.webp 1600w, /assets/hero/rugby-2560.webp 2560w" sizes="100vw" width="1600" height="679" alt="" fetchpriority="high" style="object-position:70% 50%" />
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collections' }]} />
      <span class="eyebrow">All collections</span>
      <h1 class="display" style="margin-top:1rem">Every sport. <span class="gold-text">Made to order.</span></h1>
      <p class="lead">{categories.length} collections across team sports, combat sports and performance apparel. Every product is made in your colours and quoted to your specification.</p>
    </div>
  </section>

  <section class="section section--light" aria-label="Collections by group">
    <div class="container">
      {groups.map((g) => (
        <div class="group-block" id={g.id}>
          <div class="section-head section-head--split" style="margin-bottom:1.5rem">
            <h2 class="display h3" style="font-size:var(--step-3)">{g.name}</h2>
            <p class="muted">{g.description}</p>
          </div>
          <div class="collection-list">
            {categoriesIn(g.id).map((c) => {
              const cover = coverProduct(c);
              return (
                <a class="collection-link" href={categoryUrl(c)}>
                  <span class="m">
                    {cover?.image
                      ? <img src={`${cover.image}-240.webp`} width="240" height="240" alt="" loading="lazy" decoding="async" />
                      : <img class="photo" src={`/assets/hero/${c.hero}-960.webp`} width="960" height="407" alt="" loading="lazy" decoding="async" />}
                  </span>
                  <span><strong>{c.name}</strong><small>{c.summary}</small></span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="finder-title" data-finder>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Product finder</span>
        <h2 id="finder-title" class="display h2">Search {allProducts.length} styles</h2>
      </div>
      <div class="collection-toolbar">
        <label class="search-box">
          <span class="visually-hidden">Search products</span>
          <Icon name="search" />
          <input type="search" placeholder="Search: jersey, gi, hoodie, leggings…" autocomplete="off" data-search />
        </label>
        <div class="filter-tabs" role="group" aria-label="Filter by group">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {groups.map((g) => <button type="button" aria-pressed="false" data-filter={g.id}>{g.short}</button>)}
        </div>
      </div>
      <p class="result-count" aria-live="polite" data-count>{allProducts.length} products</p>
      <div class="product-grid" style="margin-top:1rem" data-results>
        {groups.flatMap((g) => categoriesIn(g.id).filter((c) => c.kind === 'sport').flatMap((c) => c.products.map((p) => (
          <div data-group-id={g.id} style="display:contents"><ProductCard product={p} /></div>
        ))))}
      </div>
      <div class="empty-state" hidden data-empty>
        <strong>No matching products</strong>
        <p>Try another word, or <a href="/request-a-quote/">describe what you need</a> and we will quote it.</p>
      </div>
    </div>
  </section>

  <FinalCta />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]')!;
  const input = root.querySelector<HTMLInputElement>('[data-search]')!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...root.querySelectorAll<HTMLElement>('[data-group-id]')];
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  let group = 'all';

  function apply() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const card = item.querySelector<HTMLElement>('[data-product-card]')!;
      const hay = card.dataset.name ?? '';
      const ok = (group === 'all' || item.dataset.groupId === group) && terms.every((t) => hay.includes(t));
      item.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `${shown} product${shown === 1 ? '' : 's'}`;
    empty.hidden = shown > 0;
  }
  input.addEventListener('input', apply);
  buttons.forEach((b) => b.addEventListener('click', () => {
    group = b.dataset.filter!;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  const q = new URLSearchParams(location.search).get('q');
  if (q) { input.value = q; apply(); }
</script>
